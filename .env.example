# Upstash (Vercel Storage → connect the same database as your other apps)
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Helius key (same as the radio) for payments, balances and the draw
HELIUS_API_KEY=
# The coin's mint address once it's live (leave empty before launch: no holder gate yet)
TOKEN_MINT=
TOKEN_SYMBOL=GRAIL
# Optional: wallet that receives spot payments (default: the admin wallet)
TREASURY_WALLET=
# Optional: block countries (2-letter codes, comma separated), e.g. BE,FR
BLOCKED_COUNTRIES=
